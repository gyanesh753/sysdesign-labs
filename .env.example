# Local-only credentials for the lab containers.
# Copy to .env (cp .env.example .env). .env is gitignored, never commit it.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=lab
POSTGRES_PORT=5432

RUSTFS_ACCESS_KEY=labaccesskey
RUSTFS_SECRET_KEY=labsecretkey123

KAFKA_BOOTSTRAP=localhost:19092
OLLAMA_HOST=http://localhost:11434

# Optional: only if you use a hosted model instead of Ollama.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
